{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gawgroup",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-01",
  // nodejs_als for SvelteKit's request context, nodejs_compat for worker-mailer.
  "compatibility_flags": ["nodejs_als", "nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": { "enabled": true },
  // Contact form: five messages a minute per visitor address. The namespace is this Worker's own, so the two sites'
  // forms do not count against each other.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // The fallback when SMTP fails. Sending needs Email Routing on the sender's domain and a verified destination
  // (owner step); the addresses come from the SMTP_USER and MAIL_TO secrets, never from this file.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // The site's own domain; the zone must be on Cloudflare (owner step), which then creates the DNS records for both
  // hostnames. The zone's mail records (MX, SPF, DKIM, DMARC) are not touched by this.
  "routes": [
    { "pattern": "gawgroup.cz", "custom_domain": true },
    { "pattern": "www.gawgroup.cz", "custom_domain": true }
  ],
  // Pull requests upload a version with a preview alias (pr-N); since the custom domains turn workers.dev off, every
  // deploy would turn the preview URLs off with it unless this says otherwise.
  "preview_urls": true,
  // Public build-time configuration only; secrets are set with `wrangler secret put`:
  // TURNSTILE_SECRET_KEY, SMTP_USER, SMTP_PASSWORD, MAIL_TO.
  "vars": {}
}
