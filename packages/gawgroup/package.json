{
  "name": "gawgroup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "dev:https": "HTTPS=1 bun --bun vite dev --host 0.0.0.0",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "serve": "wrangler dev",
    "prepare": "bun --bun svelte-kit sync || echo ''",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "deploy": "bun --bun wrangler deploy"
  },
  "dependencies": {
    "@gaw/company": "workspace:*",
    "@gaw/contact": "workspace:*",
    "@gaw/i18n": "workspace:*",
    "@gaw/ui": "workspace:*",
    "sveltekit-i18n": "3.4.1",
    "worker-mailer": "1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@sveltekit-i18n/typegen": "3.1.1",
    "@types/bun": "1.4.4",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wrangler": "4.163.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
